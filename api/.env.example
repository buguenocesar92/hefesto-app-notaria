# ---------------------------------------------------------------------------
# Variables de entorno de la API de la aplicacion de notarias
# ---------------------------------------------------------------------------
#
# Este archivo es una PLANTILLA. Copielo a `.env` y complete los valores:
#
#   cp .env.example .env
#
# NO hay ningun valor real aqui a proposito. El `.env` nunca se sube al
# repositorio: esta en `.gitignore`.
#
# Genere APP_KEY con: php artisan key:generate
# ---------------------------------------------------------------------------

APP_NAME="Gestion de Notarias"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Santiago

APP_LOCALE=es_CL
APP_FALLBACK_LOCALE=es_CL
APP_FAKER_LOCALE=es_CL

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
#
# IMPORTANTE PARA EL AISLAMIENTO: el rol de esta conexion NO puede ser
# superusuario ni tener BYPASSRLS. Si lo fuera, PostgreSQL ignoraria las
# politicas de Row Level Security y una notaria veria los expedientes de otra.
# La comprobacion esta en:
#   php artisan notaria:verificar-aislamiento
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=notaria
DB_USERNAME=notaria_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=notaria_admin
DB_ADMIN_PASSWORD=

# El rol debe existir con estos atributos (no es superusuario, no es BYPASSRLS):
#   CREATE ROLE notaria_app LOGIN PASSWORD '...' NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;
#   CREATE DATABASE notaria OWNER notaria_app;

# ---------------------------------------------------------------------------
# Redis (cache y colas)
# ---------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------------
# Sesion
# ---------------------------------------------------------------------------
# La sesion va a la base de datos porque la API corre en varios procesos y en
# varios contenedores. Con archivos, la persona perderia la sesion al ser
# atendida por otra replica.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# En produccion DEBE ser true: sin `Secure`, la cookie viaja en texto plano.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# ---------------------------------------------------------------------------
# Autenticacion (OIDC contra Authentik)
# ---------------------------------------------------------------------------
#
# La URL de redireccion debe estar EXACTAMENTE como esta en el campo
# "Redirect URIs (strict)" del proveedor.
#
# Documentacion oficial:
# https://docs.goauthentik.io/add-secure-apps/providers/oauth2/
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/notaria/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# `openid` es obligatorio: sin el no llega el token de identificacion.
# `profile` entrega el claim `groups`; `email` entrega el correo.
AUTHENTIK_SCOPES="openid profile email"
# Algoritmo de firma del token. RS256 si Authentik tiene clave propia;
# HS256 si firma con el secreto del cliente.
AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_CACHE_SEGUNDOS=3600
AUTHENTIK_TOLERANCIA_MINUTOS=2

# ---------------------------------------------------------------------------
# Documentos
# ---------------------------------------------------------------------------
# Ruta RAIZ del volumen de documentos. La tabla `documento_versiones` guarda
# rutas relativas a esta raiz, asi que el volumen se puede mover sin tocar la
# base.
#
# IMPORTANTE: esta ruta es donde viven los documentos de los expedientes. Si
# se pierde el volumen, se pierde el historial documental, que es la parte
# del expediente que no se puede reconstruir. Ver docs/08.
DOCUMENTOS_PATH=

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
# Esta aplicacion NO envia correos por defecto. Las notificaciones a las
# partes las define cada notaria.
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Registro
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
# Canal donde van los hechos anteriores al login (intentos rechazados, tokens
# invalidos). No van a la tabla de bitacora porque todavia no hay notaria
# conocida, y la politica RLS no permite escribir en esa tabla sin una.
LOG_NOTARIA_SEGURIDAD=info